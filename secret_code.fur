// FuriLang: Секретный код
// Игра для FuriLang Studio 4.5.2
use random;
use validate;

print("=== СЕКРЕТНЫЙ КОД ===");
print("Компьютер загадал число от 1 до 20.");
print("У тебя 6 попыток, чтобы открыть сейф!");

let again = "да";
let wins = 0;
let rounds = 0;

while (again == "да") {
    rounds = rounds + 1;
    let secret = random.randint(1, 20);
    let tries = 0;
    let found = false;
    print("--- НОВЫЙ РАУНД ---");

    while (tries < 6 && found == false) {
        let answer = input("Введи число от 1 до 20: ");

        if (validate.is_digit(answer)) {
            let guess = num(answer);
            if (guess >= 1 && guess <= 20) {
                tries = tries + 1;
                if (guess == secret) {
                    found = true;
                    wins = wins + 1;
                    print("ПОБЕДА! Ты открыл сейф!");
                    print("Потрачено попыток:");
                    print(tries);
                } else {
                    if (guess < secret) {
                        print("Секретное число БОЛЬШЕ.");
                    } else {
                        print("Секретное число МЕНЬШЕ.");
                    }
                    if (abs(guess - secret) <= 2) {
                        print("Подсказка: очень близко!");
                    }
                    print("Осталось попыток:");
                    print(6 - tries);
                }
            } else {
                print("Нужно число именно от 1 до 20.");
            }
        } else {
            print("Вводи только цифры, например 12.");
        }
    }

    if (found == false) {
        print("Попытки закончились! Было загадано:");
        print(secret);
    }

    print("Побед всего:");
    print(wins);
    again = input("Сыграть ещё? Напиши да или нет: ");
}

print("Спасибо за игру в FuriLang!");
